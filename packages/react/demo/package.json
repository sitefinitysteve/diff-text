{
  "name": "react-diff-text-demo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "demo:sync": "node -e \"const fs=require('fs');fs.copyFileSync('../../../demo/demo.css','src/demo.css');fs.copyFileSync('../../../demo/content.json','src/content.json')\"",
    "predev": "npm run demo:sync",
    "dev": "vite",
    "prebuild": "npm run demo:sync",
    "build": "vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "vite": "^5.4.21"
  }
}
