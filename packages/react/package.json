{
  "name": "react-diff-text",
  "private": false,
  "version": "1.6.0",
  "description": "React components to display text and HTML differences with multiple diff strategies.",
  "main": "./dist/react-diff-text.umd.js",
  "module": "./dist/react-diff-text.mjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/react-diff-text.mjs",
      "require": "./dist/react-diff-text.umd.js"
    },
    "./dist/style.css": "./dist/style.css"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "sync-style": "node -e \"require('fs').copyFileSync('../core/src/style.css','src/style.css')\""
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@diff-text/core": "*",
    "@eslint/js": "^9.39.4",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^20.19.6",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "diff": "^8.0.2",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.0",
    "jsdom": "^28.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.2.2",
    "typescript-eslint": "^8.56.1",
    "vite": "^5.4.21",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.0.18"
  },
  "keywords": [
    "react",
    "react-component",
    "diff",
    "text-diff",
    "html-diff",
    "component"
  ],
  "author": "Steve McNiven-Scott",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sitefinitysteve/diff-text.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/sitefinitysteve/diff-text/issues"
  },
  "homepage": "https://github.com/sitefinitysteve/diff-text/tree/main/packages/react#readme"
}
