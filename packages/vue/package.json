{
  "name": "vue-diff-text",
  "private": false,
  "version": "1.6.0",
  "description": "Vue 3 components to display text and HTML differences with multiple diff strategies.",
  "main": "./dist/vue-diff-text.umd.js",
  "module": "./dist/vue-diff-text.mjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/vue-diff-text.mjs",
      "require": "./dist/vue-diff-text.umd.js"
    },
    "./dist/style.css": "./dist/style.css"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "sync-style": "node -e \"require('fs').copyFileSync('../core/src/style.css','src/style.css')\""
  },
  "peerDependencies": {
    "vue": "^3.0.0"
  },
  "devDependencies": {
    "@diff-text/core": "*",
    "@types/node": "^20.19.6",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "@vitejs/plugin-vue": "^5.0.4",
    "@vue/test-utils": "^2.4.6",
    "diff": "^8.0.2",
    "eslint": "^9.39.4",
    "eslint-plugin-vue": "^10.8.0",
    "jsdom": "^28.1.0",
    "typescript": "^5.2.2",
    "vite": "^5.2.0",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.0.18",
    "vue": "^3.4.21",
    "vue-tsc": "^2.0.6"
  },
  "keywords": [
    "vue",
    "vue3",
    "diff",
    "text-diff",
    "html-diff",
    "component"
  ],
  "author": "Steve McNiven-Scott",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sitefinitysteve/diff-text.git",
    "directory": "packages/vue"
  },
  "bugs": {
    "url": "https://github.com/sitefinitysteve/diff-text/issues"
  },
  "homepage": "https://github.com/sitefinitysteve/diff-text/tree/main/packages/vue#readme"
}
