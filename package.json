{
  "name": "diff-text-monorepo",
  "private": true,
  "description": "Text and HTML diff components for Vue, React, and PHP.",
  "workspaces": [
    "packages/core",
    "packages/vue",
    "packages/react"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test:php": "cd packages/php && composer test",
    "prepare": "husky",
    "fixtures": "tsx scripts/generate-fixtures.ts",
    "fixtures:check": "tsx scripts/check-fixtures.ts"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "tsx": "^4.23.15"
  }
}
